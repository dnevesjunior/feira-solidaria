#!/usr/bin/env bash
# Backup diário (ADR 0003, Epic 0.8). Roda no host, via cron:
#   0 3 * * * BACKUP_REMOTE=b2:feira-backups /opt/feira/bin/backup >> /var/log/feira-backup.log 2>&1
#
# Gera pg_dump (formato custom) do banco no contêiner do Kamal e um tar do
# volume de arquivos. Mantém 30 dias localmente e, se BACKUP_REMOTE estiver
# definido, envia para o object storage via rclone.
set -euo pipefail

DB_CONTAINER="${DB_CONTAINER:-feira-db}"
DB_USER="${DB_USER:-feira_solidaria}"
DB_NAME="${DB_NAME:-feira_solidaria_production}"
STORAGE_DIR="${STORAGE_DIR:-/var/lib/feira/storage}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/feira}"
KEEP_DAYS="${KEEP_DAYS:-30}"
STAMP="$(date +%Y-%m-%d-%H%M)"

mkdir -p "$BACKUP_DIR"

echo "[$STAMP] pg_dump de $DB_NAME em $DB_CONTAINER"
docker exec "$DB_CONTAINER" pg_dump -U "$DB_USER" -Fc "$DB_NAME" > "$BACKUP_DIR/db-$STAMP.dump"

if [ -d "$STORAGE_DIR" ]; then
  echo "[$STAMP] tar de $STORAGE_DIR"
  tar -czf "$BACKUP_DIR/storage-$STAMP.tar.gz" -C "$(dirname "$STORAGE_DIR")" "$(basename "$STORAGE_DIR")"
fi

find "$BACKUP_DIR" -type f -mtime "+$KEEP_DAYS" -delete

if [ -n "${BACKUP_REMOTE:-}" ]; then
  echo "[$STAMP] enviando para $BACKUP_REMOTE"
  rclone copy "$BACKUP_DIR" "$BACKUP_REMOTE" --include "*-$STAMP.*"
fi

ls -lh "$BACKUP_DIR" | tail -n 4
echo "[$STAMP] ok"
